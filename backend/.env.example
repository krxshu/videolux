# Server
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Storage
UPLOAD_DIR=temp/uploads
PROCESSED_DIR=temp/processed
MAX_FILE_SIZE_MB=500
FILE_TTL_MINUTES=60

# FFmpeg (leave blank to use system-installed ffmpeg on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# ---------------------------------------------------------------------------
# AI ENHANCEMENT PROVIDER
# This backend ships with a pluggable "AI enhancement" interface
# (see services/aiEnhancer.js). By default NO external AI model is connected,
# so the server runs in FFMPEG-ONLY mode (real classical upscaling/sharpening/
# denoising via FFmpeg filters) and is fully transparent about this to users.
#
# To connect a real AI upscaling model/API later, implement the
# `runAIEnhancement()` function in services/aiEnhancer.js and set:
# AI_PROVIDER_ENABLED=true
# AI_PROVIDER_API_URL=
# AI_PROVIDER_API_KEY=
# ---------------------------------------------------------------------------
AI_PROVIDER_ENABLED=false
AI_PROVIDER_API_URL=
AI_PROVIDER_API_KEY=
