# Server Configuration for Railway
PORT=8080
NODE_ENV=production
FRONTEND_ORIGIN=https://videolux-ai.railway.app

# Storage Configuration
UPLOAD_DIR=temp/uploads
PROCESSED_DIR=temp/processed
MAX_FILE_SIZE_MB=500
FILE_TTL_MINUTES=60

# FFmpeg Configuration (will use system ffmpeg on Railway)
FFMPEG_PATH=
FFPROBE_PATH=

# AI Enhancement Provider (disabled by default)
AI_PROVIDER_ENABLED=false
AI_PROVIDER_API_URL=
AI_PROVIDER_API_KEY=
